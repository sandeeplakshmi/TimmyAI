# Timmy settings. install.sh copies this to $TIMMY_HOME/.env (default ~/.timmy/.env).
# Never commit the filled-in copy. Secrets (the Claude API key) are entered on the
# setup page (http://localhost:8000/setup.html) and stored in Hermes' own env file.

# Where Timmy keeps personal data (sessions, briefings, device keys, add-ons).
TIMMY_HOME=
# Web page port and Hermes API server address.
TIMMY_PORT=8000
TIMMY_GATEWAY=http://127.0.0.1:8642
# Desk gadget WebSocket port.
TIMMY_GADGET_PORT=8790
# Optional wss:// URL the gadget uses when its home address doesn't answer.
TIMMY_GADGET_FALLBACK_URL=
# Morning briefing weather location (blank: no weather).
TIMMY_PLACE=
TIMMY_LAT=
TIMMY_LON=
# Local model name when not using Claude (set by the setup page).
TIMMY_LOCAL_MODEL=
# How Timmy addresses you (optional).
TIMMY_USER_NAME=
